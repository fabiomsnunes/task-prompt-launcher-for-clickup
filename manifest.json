{
  "manifest_version": 3,
  "name": "Abrir no Claude Code",
  "version": "1.0.0",
  "description": "Injeta um botao nas tasks do ClickUp que abre o Claude Code com o prompt inicial ja escrito.",
  "permissions": ["storage"],
  "host_permissions": ["https://app.clickup.com/*"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://app.clickup.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
